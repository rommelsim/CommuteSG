// Secrets.xcconfig — DO NOT COMMIT
// Real secret values live here. Mirror each key in Info.plist as $(KEY_NAME).
// Add new keys here and to Info.plist + Services/Secrets.swift.

// LTA DataMall — https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
// "//" is the C++ comment marker in xcconfig. Slashes inside the value must be escaped or avoided;
// LTA keys are base64 and may contain '/' and '+'. Use $() interpolation safely:
LTA_API_KEY = +6zJ3XstTqOcDkvczHttWA==

// Future keys (uncomment + populate when you add them):
// GOOGLE_ADS_APP_ID = ca-app-pub-XXXXXXXX~YYYYYYYY
// GOOGLE_MAPS_API_KEY = AIzaSy...
// ONEMAP_TOKEN = eyJ...
